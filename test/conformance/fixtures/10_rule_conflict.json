  "cases": [
    { "input": { "tenant": "acme",  "role": "banned" }, "expected": -1 },
    { "input": { "tenant": "acme",  "role": "viewer" }, "expected": 1 },
    { "input": { "tenant": "other", "role": "banned" }, "expected": 0 },
    { "input": { "tenant": "other", "role": "viewer" }, "expected": 0 }
  ]
}
